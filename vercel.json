{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    {
      "source": "/tools/tiktok-gmv-max-report",
      "destination": "/tools/tiktok-gmv-max-report/index.html"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
